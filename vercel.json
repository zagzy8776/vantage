{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/system/sweep",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/discover",
      "destination": "/api/discover-open"
    },
    {
      "source": "/billing",
      "destination": "/"
    }
  ]
}
