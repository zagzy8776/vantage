# ──────────────────────────────────────────────────────────────────────────────
# VANTAGE — environment variable template
#
# Copy to `.env.local` and fill in values. NEVER commit `.env*` files with
# real values. ALL variables below are SERVER-SIDE ONLY.
# Do NOT prefix variables with NEXT_PUBLIC_ unless deliberately public.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database (Neon / PostgreSQL) — Phase 2 ──────────────────────────────────
DATABASE_URL=

# ── Business discovery providers — Phase 2 ─────────────────────────────────
FOURSQUARE_API_KEY=
YELP_API_KEY=

# ── Website analysis — Phase 4 ───────────────────────────────────────────────
PAGESPEED_API_KEY=

# ── AI intelligence providers — Phase 5 ─────────────────────────────────────
# All AI credentials are server-only. The router uses this order by default.
AI_PROVIDER_ORDER=groq,cerebras,together,openrouter,minimax,pollinations
GROQ_API_KEY=
CEREBRAS_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=
MINIMAX_API_KEY=
POLLINATIONS_API_KEY=

# Production model policy: Groq is primary and Cerebras is the production
# fallback. The live model is returned by each provider and persisted with the
# analysis. Cerebras gemma-4-31b is preview/diagnostic only.
# Optional model overrides. Defaults: Groq=openai/gpt-oss-20b,
# Cerebras=gpt-oss-120b.
# GROQ_MODEL=
# CEREBRAS_MODEL=
# TOGETHER_MODEL=
# OPENROUTER_MODEL=
# MINIMAX_MODEL=
# POLLINATIONS_MODEL=

# ── Deep discovery limits — Phase 6 ─────────────────────────────────────────
MAX_CATEGORY_EXPANSIONS=5
MAX_RESEARCH_PAGES=5
MAX_ENRICHED_BUSINESSES=5
MAX_DISCOVERY_PROVIDER_SEARCHES=5
MAX_DEEP_AI_CALLS=5

# ── External web discovery and research — Phase 7 ───────────────────────────
TAVILY_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
MAX_WEB_SEARCH_QUERIES=5
MAX_TAVILY_QUERIES=3
MAX_EXA_QUERIES=3
MAX_WEB_CANDIDATES=20
MAX_FIRECRAWL_PAGES=5
WEB_DISCOVERY_PROVIDER=best-available

# ── Authentication — Phase 1 ─────────────────────────────────────────────
AUTH_SECRET=
VANTAGE_OWNER_PASSWORD=
# Free entry is the DEFAULT until the VANTAGE domain + email verification launch.
# Everyone enters as a guest owner workspace. Login/signup routes redirect home.
# Set VANTAGE_PUBLIC_MODE=false ONLY when you are ready to require real accounts.
# VANTAGE_PUBLIC_MODE=false

# ── Transactional email (signup verification) ────────────────────────────
RESEND_API_KEY=
# From address for verification emails. Defaults to onboarding@resend.dev.
EMAIL_FROM=
