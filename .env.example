# ──────────────────────────────────────────────────────────────────────────────
# VANTAGE — environment variable template
#
# Copy to `.env.local` and fill in values. NEVER commit `.env*` files with
# real values. ALL variables below are SERVER-SIDE ONLY.
# Do NOT prefix variables with NEXT_PUBLIC_ unless deliberately public.
# ──────────────────────────────────────────────────────────────────────────────

DATABASE_URL=
FOURSQUARE_API_KEY=
YELP_API_KEY=
PAGESPEED_API_KEY=

AI_PROVIDER_ORDER=groq,cerebras,together,openrouter,minimax,pollinations
GROQ_API_KEY=
CEREBRAS_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=
MINIMAX_API_KEY=
POLLINATIONS_API_KEY=

MAX_CATEGORY_EXPANSIONS=5
MAX_RESEARCH_PAGES=5
MAX_ENRICHED_BUSINESSES=5
MAX_DISCOVERY_PROVIDER_SEARCHES=5
MAX_DEEP_AI_CALLS=5

TAVILY_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
MAX_WEB_SEARCH_QUERIES=5
MAX_TAVILY_QUERIES=3
MAX_EXA_QUERIES=3
MAX_WEB_CANDIDATES=20
MAX_FIRECRAWL_PAGES=5
MAX_PHONE_RECOVERY_QUERIES=20
WEB_DISCOVERY_PROVIDER=best-available

# ── Jobs intelligence — server-side only ─────────────────────────────────────
# These are discovery sources. Vantage must verify employer ownership
# against an official company/ATS source before a direct-hire verdict.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
OPENWEBNINJA_API_KEY=
JOBSPIPE_API_KEY=
HIREBASE_API_KEY=
THEIRSTACK_API_KEY=
MAX_JOB_PROVIDER_RESULTS=100
MAX_JOB_VERIFICATION_PAGES=5
JOB_VERIFICATION_MAX_AGE_DAYS=30

# ── Deep web job discovery ───────────────────────────────────────────────────
# Uses configured web-research providers to discover public job and career
# surfaces that traditional job APIs miss. Missing keys simply disable that
# engine; source provenance is retained internally and hidden from users.
VANTAGE_ENABLE_DEEP_WEB_DISCOVERY=true
JOB_DEEP_SEARCH_TIMEOUT_MS=12000
JOB_DEEP_SEARCH_RESULTS=12
JOB_DEEP_MAX_CANDIDATES=40
JOB_DEEP_DETAIL_PAGES=18
JOB_DEEP_VERIFY_LIMIT=12
FIRECRAWL_SEARCH_URL=https://api.firecrawl.dev/v2/search

# ── Regional job discovery ───────────────────────────────────────────────────
# Public feeds are safe to use when published for syndication. Generic web
# crawling remains separately gated at runtime for sources whose terms require
# explicit permission or opt-in.
VANTAGE_ENABLE_REGIONAL_WEB_CRAWL=false
JOB_SCRAPER_TIMEOUT_MS=10000
JOB_SCRAPER_DETAIL_PAGES=12
JOB_MAX_DISCOVERED_FEEDS=8

AUTH_SECRET=
VANTAGE_OWNER_PASSWORD=
# VANTAGE_PUBLIC_MODE=false
RESEND_API_KEY=
EMAIL_FROM=
